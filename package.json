{
  "name": "tower-def",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "sim:maze": "tsx tools/sim-maze.ts",
    "sim:duel": "tsx tools/sim-duel.ts",
    "sim:duel-batch": "tsx tools/sim-duel-batch.ts",
    "gen:sfx": "tsx tools/generate-sfx.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && vitest run"
  },
  "dependencies": {
    "phaser": "^4.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
